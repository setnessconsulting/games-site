---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import WebglGameFrame from "../../components/WebglGameFrame.astro";
import { getGame, getGameAssetBase } from "../../data/games";

const game = getGame("signal-garden");
if (!game) throw new Error("Signal Garden is missing from the catalog");

const release =
  game.status === "playable" && game.release?.kind === "unity-webgl" ? game.release : undefined;
const assetBase = release ? getGameAssetBase(game) : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <div class="play-toolbar">
      <a class="back-link" href={game.route}>
        ← Game page
      </a>
      <span class="play-label">{game.title}</span>
      {assetBase && release ? (
        <button class="text-button" type="button" data-fullscreen>
          Fullscreen
        </button>
      ) : null}
    </div>
    {assetBase && release ? (
      <WebglGameFrame
        title={game.title}
        version={release.version}
        assetBase={assetBase}
        loaderFile={release.loaderFile}
        dataFile={release.dataFile}
        frameworkFile={release.frameworkFile}
        wasmFile={release.wasmFile}
        returnRoute={game.route}
      />
    ) : (
      <section class="not-ready-panel">
        <p class="eyebrow">Coming soon</p>
        <h1>The garden is still growing.</h1>
        <p>There isn’t a playable build here yet. Come back after the next release.</p>
        <a class="button button-primary" href={game.route}>
          Return to {game.title}
        </a>
      </section>
    )}
  </main>
</BaseLayout>

<script is:inline>
  const button = document.querySelector("[data-fullscreen]");
  const stage = document.querySelector("[data-game-stage]");

  button?.addEventListener("click", async () => {
    try {
      if (!document.fullscreenElement) {
        await stage?.requestFullscreen();
        button.textContent = "Exit fullscreen";
      } else {
        await document.exitFullscreen();
        button.textContent = "Fullscreen";
      }
    } catch {
      button.textContent = "Fullscreen unavailable";
    }
  });
</script>
