---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameLauncher from "../../components/GameLauncher.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getGame } from "../../data/games";

const game = getGame("new-world-01");
if (!game) throw new Error("New World 01 is missing from the catalog");
---

<BaseLayout title={game.title} description={game.description}>
  <SiteHeader compact />
  <main class="page-shell launcher-page">
    <a class="back-link" href="/">
      ← Collection
    </a>
    <GameLauncher game={game} />
  </main>
</BaseLayout>
