---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import PlayToolbar from "../../components/PlayToolbar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { MOTION_LAB_SLUG, getGame, getStaticWebPlaySource } from "../../data/games";

const game = getGame(MOTION_LAB_SLUG);
if (!game) throw new Error("Motion Lab is missing from the catalog");

// GAME-401 / ML-PROMOTE: this route is now a promoted play route, not a preview-gated one, so the
// source comes from the status-gated promoted accessor. Under the promoted entry it always
// resolves; the unavailable panel below is therefore a configuration fault rather than the
// intentional production state it used to describe.
const playSource = getStaticWebPlaySource(game);
const entryUrl = playSource ? `${playSource.assetBase}/${playSource.release.entryFile}` : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <PlayToolbar
      game={game}
      canFullscreen={Boolean(entryUrl)}
      fullscreenStage="[data-static-game-stage]"
    />
    {entryUrl ? (
      <StaticGameFrame title={game.title} entryUrl={entryUrl} gamePageUrl={game.route} />
    ) : (
      <GameUnavailable
        game={game}
        heading="The experiment bench could not be loaded."
        description="This build selects no Motion Lab release, so there is nothing to frame here. The catalog entry is playable, which makes this a deployment fault rather than a deliberate state — the promoted release should always resolve."
      />
    )}
  </main>
</BaseLayout>
