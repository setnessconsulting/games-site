---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticWebGameFrame from "../../components/StaticWebGameFrame.astro";
import { getGame, getStaticWebPlaySource } from "../../data/games";

const game = getGame("number-line-jumper");
if (!game) throw new Error("Number Line Jumper is missing from the catalog");

const playSource = getStaticWebPlaySource(game);
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <div class="play-toolbar">
      <a class="back-link" href={game.route}>
        ← Game page
      </a>
      <span class="play-label">{game.title}</span>
      {playSource ? (
        <button class="text-button" type="button" data-fullscreen>
          Fullscreen
        </button>
      ) : null}
    </div>
    {playSource ? (
      <StaticWebGameFrame
        title={game.title}
        assetBase={playSource.assetBase}
        entryFile={playSource.release.entryFile}
      />
    ) : (
      <GameUnavailable
        game={game}
        heading="Number Line Jumper is not published yet."
        description="The arcade route is ready, but no validated production release has been promoted."
      />
    )}
  </main>
</BaseLayout>

<script is:inline>
  const button = document.querySelector("[data-fullscreen]");
  const stage = document.querySelector("[data-game-stage]");

  button?.addEventListener("click", async () => {
    try {
      if (!document.fullscreenElement) {
        await stage?.requestFullscreen();
        button.textContent = "Exit fullscreen";
      } else {
        await document.exitFullscreen();
        button.textContent = "Fullscreen";
      }
    } catch {
      button.textContent = "Fullscreen unavailable";
    }
  });
</script>
