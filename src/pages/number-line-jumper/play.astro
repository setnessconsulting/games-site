---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import PlayToolbar from "../../components/PlayToolbar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticWebGameFrame from "../../components/StaticWebGameFrame.astro";
import { getGame, getStaticWebPlaySource } from "../../data/games";

const game = getGame("number-line-jumper");
if (!game) throw new Error("Number Line Jumper is missing from the catalog");

const playSource = getStaticWebPlaySource(game);
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <PlayToolbar
      game={game}
      canFullscreen={Boolean(playSource)}
      fullscreenStage="[data-game-stage]"
    />
    {playSource ? (
      <StaticWebGameFrame
        title={game.title}
        assetBase={playSource.assetBase}
        entryFile={playSource.release.entryFile}
        gamePageUrl={game.route}
      />
    ) : (
      <GameUnavailable
        game={game}
        heading="Number Line Jumper is not published yet."
        description="The arcade route is ready, but no validated production release has been promoted."
      />
    )}
  </main>
</BaseLayout>
