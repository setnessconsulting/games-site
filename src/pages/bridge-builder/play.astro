---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import PlayToolbar from "../../components/PlayToolbar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { getGame, getStaticWebPlaySource } from "../../data/games";
import { appendGpsdkQuery, createGpsdkSessionIds } from "../../lib/gpsdk-bridge-builder-host";

const game = getGame("bridge-builder");
if (!game) throw new Error("Bridge Builder is missing from the catalog");

const playSource = getStaticWebPlaySource(game);
const baseEntryUrl = playSource
  ? `${playSource.assetBase}/${playSource.release.entryFile}`
  : undefined;
// SDK-6: Bridge Builder is the first game to opt into the GPSDK host wire.
const gpsdkIds = baseEntryUrl ? createGpsdkSessionIds() : undefined;
const entryUrl = baseEntryUrl && gpsdkIds ? appendGpsdkQuery(baseEntryUrl, gpsdkIds) : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <PlayToolbar
      game={game}
      canFullscreen={Boolean(entryUrl)}
      fullscreenStage="[data-static-game-stage]"
    />
    {entryUrl && gpsdkIds ? (
      <StaticGameFrame
        title={game.title}
        entryUrl={entryUrl}
        gamePageUrl={game.route}
        gpsdkChannel={gpsdkIds.channelId}
        gpsdkSession={gpsdkIds.sessionId}
      />
    ) : (
      <GameUnavailable
        game={game}
        heading="The bridge is unavailable right now."
        description="There isn’t a playable build here right now. Return to the game page and try again later."
      />
    )}
  </main>
</BaseLayout>
