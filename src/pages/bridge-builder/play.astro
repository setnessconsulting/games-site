---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { getGame, getGameAssetBase } from "../../data/games";

const game = getGame("bridge-builder");
if (!game) throw new Error("Bridge Builder is missing from the catalog");

const assetBase = getGameAssetBase(game);
const release = game.release?.kind === "static-web" ? game.release : undefined;
const entryUrl = assetBase && release ? `${assetBase}/${release.entryFile}` : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <div class="play-toolbar">
      <a class="back-link" href="/bridge-builder/">
        ← Game page
      </a>
      <span class="play-label">{game.title}</span>
      {entryUrl ? (
        <button class="text-button" type="button" data-fullscreen>
          Fullscreen
        </button>
      ) : null}
    </div>
    {entryUrl ? (
      <StaticGameFrame title={game.title} entryUrl={entryUrl} gamePageUrl="/bridge-builder/" />
    ) : (
      <section class="not-ready-panel">
        <p class="eyebrow">Coming soon</p>
        <h1>The bridge is unavailable right now.</h1>
        <p>
          There isn’t a playable build here right now. Return to the game page and try again later.
        </p>
        <a class="button button-primary" href="/bridge-builder/">
          Return to Bridge Builder
        </a>
      </section>
    )}
  </main>
</BaseLayout>

<script is:inline>
  const fullscreenButton = document.querySelector("[data-fullscreen]");
  const fullscreenStage = document.querySelector("[data-static-game-stage]");

  fullscreenButton?.addEventListener("click", async () => {
    try {
      if (!document.fullscreenElement) {
        await fullscreenStage?.requestFullscreen();
        fullscreenButton.textContent = "Exit fullscreen";
      } else {
        await document.exitFullscreen();
        fullscreenButton.textContent = "Fullscreen";
      }
    } catch {
      fullscreenButton.textContent = "Fullscreen unavailable";
    }
  });
</script>
