---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import GameLauncher from "../../components/GameLauncher.astro";
import { getGame } from "../../data/games";

const game = getGame("bridge-builder");
if (!game) throw new Error("Bridge Builder is missing from the catalog");
---

<BaseLayout title={game.title} description={game.description}>
  <SiteHeader compact />
  <main class="page-shell launcher-page">
    <a class="back-link" href="/">
      ← Collection
    </a>
    <GameLauncher game={game} />
    <p class="game-note">
      Choose planks that close the gap exactly, then guide the car safely across the bridge.
    </p>
  </main>
</BaseLayout>
