---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import PlayToolbar from "../../components/PlayToolbar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { getGame, getStaticWebPlaySource } from "../../data/games";

const game = getGame("weather-command");
if (!game) throw new Error("Weather Command is missing from the catalog");

const playSource = getStaticWebPlaySource(game);
const entryUrl = playSource ? `${playSource.assetBase}/${playSource.release.entryFile}` : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <PlayToolbar
      game={game}
      canFullscreen={Boolean(entryUrl)}
      fullscreenStage="[data-static-game-stage]"
    />
    {entryUrl ? (
      <StaticGameFrame title={game.title} entryUrl={entryUrl} gamePageUrl={game.route} />
    ) : (
      <GameUnavailable
        game={game}
        heading="The forecast desk is still being prepared."
        description="There isn’t a qualified Weather Command build here yet. Production stays intentionally unavailable until the immutable game candidate passes its science, accessibility, comparator, device, and playtest gates."
      />
    )}
  </main>
</BaseLayout>
