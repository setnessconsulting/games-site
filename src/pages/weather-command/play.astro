---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { getGame, getGameAssetBase } from "../../data/games";

const game = getGame("weather-command");
if (!game) throw new Error("Weather Command is missing from the catalog");

const assetBase = getGameAssetBase(game);
const release = game.release?.kind === "static-web" ? game.release : undefined;
const entryUrl = assetBase && release ? `${assetBase}/${release.entryFile}` : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <div class="play-toolbar">
      <a class="back-link" href={game.route}>
        ← Game page
      </a>
      <span class="play-label">{game.title}</span>
      {entryUrl ? (
        <button class="text-button" type="button" data-weather-command-fullscreen>
          Fullscreen
        </button>
      ) : null}
    </div>
    {entryUrl ? (
      <StaticGameFrame title={game.title} entryUrl={entryUrl} gamePageUrl={game.route} />
    ) : (
      <section class="not-ready-panel">
        <p class="eyebrow">Coming soon</p>
        <h1>The forecast desk is still being prepared.</h1>
        <p>
          There isn’t a qualified Weather Command build here yet. Production stays intentionally
          unavailable until the immutable game candidate passes its science, accessibility,
          comparator, device, and playtest gates.
        </p>
        <a class="button button-primary" href={game.route}>
          Return to {game.title}
        </a>
      </section>
    )}
  </main>
</BaseLayout>

<script is:inline>
  const weatherCommandFullscreenButton = document.querySelector(
    "[data-weather-command-fullscreen]"
  );
  const weatherCommandFullscreenStage = document.querySelector("[data-static-game-stage]");

  weatherCommandFullscreenButton?.addEventListener("click", async () => {
    try {
      if (!document.fullscreenElement) {
        await weatherCommandFullscreenStage?.requestFullscreen();
        weatherCommandFullscreenButton.textContent = "Exit fullscreen";
      } else {
        await document.exitFullscreen();
        weatherCommandFullscreenButton.textContent = "Fullscreen";
      }
    } catch {
      weatherCommandFullscreenButton.textContent = "Fullscreen unavailable";
    }
  });
</script>
