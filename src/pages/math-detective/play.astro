---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { getGame, getStaticWebPlaySource } from "../../data/games";

const game = getGame("math-detective");
if (!game) throw new Error("Math Detective is missing from the catalog");

const playSource = getStaticWebPlaySource(game);
const entryUrl = playSource ? `${playSource.assetBase}/${playSource.release.entryFile}` : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <div class="play-toolbar">
      <a class="back-link" href={game.route}>
        ← Game page
      </a>
      <span class="play-label">{game.title}</span>
      {entryUrl ? (
        <button class="text-button" type="button" data-fullscreen>
          Fullscreen
        </button>
      ) : null}
    </div>
    {entryUrl ? (
      <StaticGameFrame title={game.title} entryUrl={entryUrl} gamePageUrl={game.route} />
    ) : (
      <GameUnavailable
        game={game}
        heading="The case file is still being prepared."
        description="There isn’t a playable build here yet. Return to the game page and try again later."
      />
    )}
  </main>
</BaseLayout>

<script is:inline>
  const button = document.querySelector("[data-fullscreen]");
  const fullscreenStage = document.querySelector("[data-static-game-stage]");

  button?.addEventListener("click", async () => {
    try {
      if (!document.fullscreenElement) {
        await fullscreenStage?.requestFullscreen();
        button.textContent = "Exit fullscreen";
      } else {
        await document.exitFullscreen();
        button.textContent = "Fullscreen";
      }
    } catch {
      button.textContent = "Fullscreen unavailable";
    }
  });
</script>
