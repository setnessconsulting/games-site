---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameUnavailable from "../../components/GameUnavailable.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StaticGameFrame from "../../components/StaticGameFrame.astro";
import { getGame, getStaticWebPlaySource } from "../../data/games";

const game = getGame("ecosystem-rescue");
if (!game) throw new Error("Ecosystem Rescue is missing from the catalog");

const playSource = getStaticWebPlaySource(game);
const entryUrl = playSource ? `${playSource.assetBase}/${playSource.release.entryFile}` : undefined;
---

<BaseLayout title={`Play ${game.title}`} description={`Play ${game.title} at Setness Games.`}>
  <SiteHeader compact />
  <main class="play-page page-shell">
    <div class="play-toolbar">
      <a class="back-link" href={game.route}>
        ← Game page
      </a>
      <span class="play-label">{game.title}</span>
      {entryUrl ? (
        <button class="text-button" type="button" data-ecosystem-rescue-fullscreen>
          Fullscreen
        </button>
      ) : null}
    </div>
    {entryUrl ? (
      <StaticGameFrame title={game.title} entryUrl={entryUrl} gamePageUrl={game.route} />
    ) : (
      <GameUnavailable
        game={game}
        heading="The pond is still being prepared."
        description="There isn’t a qualified Ecosystem Rescue build here yet. Production stays intentionally unavailable until the candidate passes its science, accessibility, comparator, device, and playtest gates."
      />
    )}
  </main>
</BaseLayout>

<script is:inline>
  const ecosystemRescueFullscreenButton = document.querySelector(
    "[data-ecosystem-rescue-fullscreen]"
  );
  const ecosystemRescueFullscreenStage = document.querySelector("[data-static-game-stage]");

  ecosystemRescueFullscreenButton?.addEventListener("click", async () => {
    try {
      if (!document.fullscreenElement) {
        await ecosystemRescueFullscreenStage?.requestFullscreen();
        ecosystemRescueFullscreenButton.textContent = "Exit fullscreen";
      } else {
        await document.exitFullscreen();
        ecosystemRescueFullscreenButton.textContent = "Fullscreen";
      }
    } catch {
      ecosystemRescueFullscreenButton.textContent = "Fullscreen unavailable";
    }
  });
</script>
