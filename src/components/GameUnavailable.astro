---
import type { GameEntry } from "../data/games";

interface Props {
  game: GameEntry;
}

const { game } = Astro.props;
---

<section class="not-ready-panel">
  <p class="eyebrow">Coming soon</p>
  <h1>{game.unavailableCopy.heading}</h1>
  <p>{game.unavailableCopy.description}</p>
  <a class="button button-primary" href={game.route}>
    Return to {game.title}
  </a>
</section>
