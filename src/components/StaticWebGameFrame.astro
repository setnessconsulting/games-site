---
import GameFrameOverlays from "./GameFrameOverlays.astro";

interface Props {
  title: string;
  assetBase: string;
  entryFile: string;
  gamePageUrl: string;
}

const { title, assetBase, entryFile, gamePageUrl } = Astro.props;
const entryUrl = `${assetBase}/${entryFile}`;
---

<div
  class="game-stage static-game-stage"
  data-game-stage
  data-release-kind="static-web"
  data-asset-base={assetBase}
>
  <GameFrameOverlays kind="static" title={title} returnHref={gamePageUrl} />
  <iframe
    class="static-game-frame"
    data-static-game-frame
    src={entryUrl}
    title={`${title} game`}
    loading="eager"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="autoplay; fullscreen"
    allowfullscreen
  ></iframe>
</div>

<script>
  import { wireStaticGameIframe } from "../lib/static-game-iframe";

  wireStaticGameIframe(document.querySelector('[data-game-stage][data-release-kind="static-web"]'));
</script>
