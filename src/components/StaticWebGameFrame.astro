---
import GameFrameOverlays from "./GameFrameOverlays.astro";

interface Props {
  title: string;
  assetBase: string;
  entryFile: string;
  gamePageUrl: string;
}

const { title, assetBase, entryFile, gamePageUrl } = Astro.props;
const entryUrl = `${assetBase}/${entryFile}`;
---

<div
  class="game-stage static-game-stage"
  data-game-stage
  data-release-kind="static-web"
  data-asset-base={assetBase}
>
  <GameFrameOverlays kind="static" title={title} returnHref={gamePageUrl} />
  <iframe
    class="static-game-frame"
    data-static-game-frame
    src={entryUrl}
    title={`${title} game`}
    loading="eager"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="autoplay; fullscreen"
    allowfullscreen
  ></iframe>
</div>

<script is:inline>
  (() => {
    const stage = document.querySelector('[data-game-stage][data-release-kind="static-web"]');
    const loading = stage?.querySelector("[data-static-game-loading]");
    const error = stage?.querySelector("[data-static-game-error]");
    const frame = stage?.querySelector("[data-static-game-frame]");

    const showError = () => {
      loading?.setAttribute("hidden", "true");
      frame?.setAttribute("hidden", "true");
      error?.removeAttribute("hidden");
    };

    if (!stage || !loading || !error || !frame) {
      showError();
    } else {
      frame.addEventListener("load", () => {
        loading.setAttribute("hidden", "true");
      });
      frame.addEventListener("error", showError);
      window.setTimeout(() => {
        if (!frame.contentDocument && !frame.hasAttribute("hidden")) showError();
      }, 12_000);
    }
  })();
</script>
