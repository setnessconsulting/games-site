---
import GameFrameOverlays from "./GameFrameOverlays.astro";

interface Props {
  title: string;
  entryUrl: string;
  gamePageUrl: string;
  /** Bridge Builder GPSDK opt-in (SDK-6). Other games omit this. */
  gpsdkEnabled?: boolean;
}

const { title, entryUrl, gamePageUrl, gpsdkEnabled = false } = Astro.props;
---

<div
  class="static-game-stage"
  data-static-game-stage
  data-gpsdk-enabled={gpsdkEnabled ? "true" : undefined}
>
  <GameFrameOverlays kind="static" title={title} returnHref={gamePageUrl} />
  <iframe
    class="static-game-frame"
    data-static-game-frame
    title={`${title} game`}
    src={gpsdkEnabled ? undefined : entryUrl}
    data-gpsdk-entry-url={gpsdkEnabled ? entryUrl : undefined}
    loading="eager"
    allow="fullscreen"
    allowfullscreen
    referrerpolicy="same-origin"
  ></iframe>
</div>

<script>
  import { wireStaticGameIframe } from "../lib/static-game-iframe";
  import { activateBridgeBuilderGpsdkFrame } from "../lib/gpsdk-bridge-builder-host";

  const stage = document.querySelector("[data-static-game-stage]");
  const frame = stage?.querySelector<HTMLIFrameElement>("[data-static-game-frame]");
  const entryUrl = frame?.getAttribute("data-gpsdk-entry-url");

  if (stage?.getAttribute("data-gpsdk-enabled") === "true" && frame && entryUrl) {
    const activation = activateBridgeBuilderGpsdkFrame(stage, frame, entryUrl);
    if (activation) {
      window.addEventListener("pagehide", activation.wire.destroy, { once: true });
    }
  }

  // For the GPSDK route, activation installs the message listener before it
  // assigns the iframe URL. Other static games keep their original src path.
  wireStaticGameIframe(stage);
</script>
