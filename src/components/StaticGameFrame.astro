---
import GameFrameOverlays from "./GameFrameOverlays.astro";

interface Props {
  title: string;
  entryUrl: string;
  gamePageUrl: string;
}

const { title, entryUrl, gamePageUrl } = Astro.props;
---

<div class="static-game-stage" data-static-game-stage>
  <GameFrameOverlays kind="static" title={title} returnHref={gamePageUrl} />
  <iframe
    class="static-game-frame"
    data-static-game-frame
    title={`${title} game`}
    src={entryUrl}
    loading="eager"
    allow="fullscreen"
    allowfullscreen
    referrerpolicy="same-origin"
  ></iframe>
</div>

<script>
  import { wireStaticGameIframe } from "../lib/static-game-iframe";

  wireStaticGameIframe(document.querySelector("[data-static-game-stage]"));
</script>
