---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = "Setness Games" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#10222b" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · {eyebrow}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
