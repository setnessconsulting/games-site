{
  "name": "games-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "preview:pages": "wrangler pages dev dist",
    "build": "astro check && astro build",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "check:functions": "tsc -p functions/tsconfig.json --noEmit",
    "check:wrangler": "wrangler types --check --path=functions/types.d.ts",
    "types:wrangler": "wrangler types --path=functions/types.d.ts",
    "verify": "npm run types:wrangler && npm run validate:catalog && npm run validate:routes && npm run lint && npm run format:check && npm run check && npm run check:functions && npm run test && npm run build"
  },
  "dependencies": {
    "@setnessconsulting/game-platform-sdk": "https://github.com/setnessconsulting/project-game-platform-sdk.git#sdk-v0.1.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
