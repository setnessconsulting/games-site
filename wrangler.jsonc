{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "games-site",
  "compatibility_date": "2026-09-15",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "GAME_ASSETS",
      "bucket_name": "setnessconsulting-games"
    }
  ],
  "env": {
    "preview": {
      "r2_buckets": [
        {
          "binding": "GAME_ASSETS",
          "bucket_name": "setnessconsulting-games"
        }
      ],
      "vars": {
        "BRIDGE_BUILDER_PREVIEW_VERSION": "0.1.0-qualification.10",
        "NUMBER_LINE_JUMPER_PREVIEW_VERSION": "main-12641c0",
        "MATH_DETECTIVE_PREVIEW_VERSION": "2026.09.21-playtest-enhancements.1",
        "ECOSYSTEM_RESCUE_PREVIEW_VERSION": "0.1.0-qualification.5",
        "WEATHER_COMMAND_PREVIEW_VERSION": "0.1.0-qualification.2",
        "FRACTION_MATCH_PREVIEW_VERSION": "0.1.0-qualification.1",
        // Deliberately empty, and declared rather than omitted. Planetary Survey has no
        // published candidate yet, so naming a version here would point the preview
        // environment at an R2 object that does not exist. Empty is treated as
        // "not configured" everywhere it is read, so this changes nothing at runtime
        // while keeping the variable declared and typed for the qualification pass
        // that will set it. The other games carry real versions because their
        // candidates are published.
        "PLANETARY_SURVEY_PREVIEW_VERSION": "",
        // Motion Lab is promoted (GAME-401 / ML-PROMOTE), so this is the same preview-only
        // exact-version override the other promoted static-web games carry. Empty means "not
        // configured", so every environment selects the committed
        // MOTION_LAB_PRODUCTION_VERSION from the catalog. Setting it pins one candidate for a
        // future qualification pass; it cannot promote anything by itself.
        "MOTION_LAB_PREVIEW_VERSION": ""
      }
    }
  }
}
